# Application
NODE_ENV=development
PORT=3000

# Firebase Admin
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Lokal geliştirme için Firestore emülatörü (opsiyonel)
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# OneSignal Push Notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# Adapty Webhook
# Adapty Dashboard > App Settings > Webhook > Authorization header value
ADAPTY_WEBHOOK_SECRET=""
# Adapty Dashboard > App Settings > General > API keys > Secret key
# Premium'un doğruluk kaynağı: webhook ve /users/me/premium/sync bununla Adapty'yi sorgular
ADAPTY_SECRET_KEY=""
